# Application Environment Variables
NODE_ENV=production
PORT=5000

# MongoDB Configuration (Use MongoDB Atlas Free Tier)
MONGODB_URI={{ mongodb_uri }}

# JWT Configuration
JWT_SECRET={{ jwt_secret }}
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://{{ ansible_host }}

# Application URLs
FRONTEND_URL=http://{{ ansible_host }}
BACKEND_URL=http://{{ ansible_host }}:5000
